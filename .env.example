# -----------------------------------------------------------------------------
# Local environment variables for Extracurricular Dashboard
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Only publishable (public-by-design) Supabase values belong in the app.
# Never add a service-role key, database password, or access token here.
# -----------------------------------------------------------------------------

# Supabase project URL (safe to expose to browsers)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (safe to expose to browsers; replaces the legacy
# anon key for new applications). Find it in Supabase Dashboard > Settings
# > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
